# Data files
*.csv
*.txt

# Output Plots
*.png

# MCMC run outputs
# Chains are large binaries (tens of MB each); run configs are regenerated by
# every fit and restored automatically by --replot.
*.npz
*_run_config.json

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
# (.venv also self-ignores via its own .gitignore, this is belt-and-braces)
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Caches
.mpl/

# macOS
.DS_Store

# ---------------------------------------------------------------------------
# Not part of the CLOAK release. These stay on disk but are never tracked:
# real Chandra data and fit results, notebooks, legacy code, one-off helper
# scripts, manuscript sources, reference PDFs, editor state and scratch.
# Remove a line here (and `git add` the path) to start tracking it again.
# ---------------------------------------------------------------------------
data/
mcmc_results/
notebooks/
legacy_r_code/
extras/
temp/
paper/
*.pdf
.cursor/
.vscode/
.swp
*.swp

# Synthetic data products are released: re-include them under synthetic_data/
# despite the blanket *.csv / *.txt / *.json rules above.
!synthetic_data/**/*.csv
!synthetic_data/**/*.txt
!synthetic_data/**/*.json
